# Copy to .env and fill in. Never commit .env.
# None of these use NEXT_PUBLIC_: nothing here is sent to the browser.

# Local Postgres 18 (Homebrew). Create both databases once:
#   createdb movie_memory && createdb movie_memory_test
DATABASE_URL="postgresql://localhost:5432/movie_memory"
# Used only by tests (npm test) and npm run db:test:prepare. Never by the app.
TEST_DATABASE_URL="postgresql://localhost:5432/movie_memory_test"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# OpenAI (server-only)
OPENAI_API_KEY="replace-me"
# Optional. Model used for fact generation; when unset, the default in code is used.
# OPENAI_MODEL=""

# Fact strategy: "generate" (default) or "pool"
FACT_STRATEGY="generate"
# Pool cap per movie (pool strategy only)
FACT_POOL_SIZE="10"
