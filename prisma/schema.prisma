// Data model: SPEC §3. Auth models come from the Better Auth CLI (SPEC §3.2).
// Rules: every timestamp is @db.Timestamptz(3); time comparisons use the DB clock.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth models: generated by `npx auth@1.7.25 generate --adapter prisma`.
// Only change from CLI output: @db.Timestamptz(3) on timestamps (CLAUDE.md rule).
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@unique([email])
  @@map("user")
}
